log_dir <- here::here("output", "logs")
if (!dir.exists(log_dir)) dir.create(log_dir, recursive = TRUE)
logfile <- file.path(log_dir, paste0("run_", format(Sys.time(), "%Y-%m-%d_%H-%M-%S"), ".log"))
sink(logfile, split = TRUE)
sessionInfo()
sink()
