iv_models  <- purrr::map(outcomes, ~ feols(build_formula(.x),  data = df, cluster = ~bula:year))
summary(iv_models, diagnostics = TRUE)
etable(iv_models, diagnostics = TRUE)
etable(iv_models, diagnostics = TRUE)              # Konsole
etable(iv_models,
fitstat = ~ . + kpr + wh + sargan)  # KP# Export: Haupttabellen
etable(iv_models,
fitstat = ~ . + kpr)  # KP# Export: Haupttabellen
kpf_vals <- map(iv_models, ~ fitstat(.x, "kpr", simplify = TRUE, verbose = FALSE))
iv <- feols(build_formula(.x), data = df, cluster = ~bula:year)
y <- "health"
# 2) IV-Modell (2SLS) schätzen – Second Stage kommt automatisch
iv_one <- feols(build_formula(y), data = df, cluster = ~ bula:year)
summary(iv_one)                  # Koeffizienten der Second Stage
fixest::fitstat(iv_one, "kpr")
summary(iv_one, diagnostics = TRUE)                  # Koeffizienten der Second Stage
kpf_vals <- imap(iv_models, ~ fitstat(.x, "kpr",
vcov = ~ bula:year,   # exakt 1 Cluster-Ebene
simplify = TRUE, verbose = FALSE))
kpf_vals <- imap(iv_one, ~ fitstat(.x, "kpr",
vcov = ~ bula:year,   # exakt 1 Cluster-Ebene
simplify = TRUE, verbose = FALSE))
source(here::here("code", "0-setup.R"))
df <- readRDS(here::here("data", "derived", "postinstrument.rds"))
plot_hist <- function(data, var_code, axis_label, title_label, bins = 30) {
artikel <- ifelse(var_code %in% der_vars, "der", "des")
ggplot(data, aes_string(x = var_code)) +
geom_histogram(bins = bins, fill = "#4e4e4e", color = "white") +
theme_minimal(base_size = 14) +
labs(x = axis_label, y = "Häufigkeit",
title = paste("Verteilung", artikel, title_label)) +
theme(plot.title = element_text(hjust = 0.5, face = "bold"),
axis.text  = element_text(color = "black"))}
# Unterordner erstellen
dir.create(here::here("output", "figures", "figureA1"), recursive = TRUE, showWarnings = FALSE)
